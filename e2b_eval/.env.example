# E2B 自托管服务。E2B Cloud 请把 E2B_API_URL 和 E2B_SANDBOX_URL 留空。
export E2B_API_URL="http://<e2b-host>:3000"
export E2B_SANDBOX_URL="http://<e2b-host>:3002"
export E2B_API_KEY="e2b_..."
export E2B_TEMPLATE="e2b-dressage-claw-blackbox"
export E2B_SANDBOX_TIMEOUT_SEC="3600"

# 沙箱内 OpenClaw 使用的 OpenAI 兼容接口。BlackboxServer 把模型调用转发到这里。
# 数据会离开沙箱，请使用获批的接口和专用 key。
export AGENT_LLM_BASE_URL="https://api.deepseek.com/v1"
export AGENT_LLM_API_KEY="sk-..."
export AGENT_LLM_MODEL="deepseek-flash"
export AGENT_LLM_PROVIDER_ID="deepseek"
export AGENT_LLM_CONTEXT_WINDOW="65536"
export AGENT_LLM_MAX_TOKENS="4096"
export AGENT_MAX_STEPS="40"
export AGENT_TURN_TIMEOUT_SEC="900"
