{
  "schema_version": "omni_task.v2",
  "id": "ivf-similar-patients-and-prediction-age-amh",
  "name": "ivf-similar-cohort-and-outcome-prediction",
  "prompt": "prompt.md",
  "files": {
    "task": [
      {
        "source": "workspace",
        "target": "/workspace",
        "copy_mode": "contents",
        "required": true
      },
      {
        "source": "scripts",
        "target": "/tmp/omni_task/scripts",
        "copy_mode": "contents",
        "required": true
      },
      {
        "source": "tools",
        "target": "/tmp/omni_task/tools",
        "copy_mode": "contents",
        "required": true
      },
      {
        "source": "services",
        "target": "/tmp/omni_services",
        "copy_mode": "contents",
        "required": true
      },
      {
        "source": "runtime",
        "target": "/tmp/omni_task/runtime",
        "copy_mode": "contents",
        "required": true
      }
    ]
  },
  "runtime": {
    "task_mount_path": "/tmp/omni_task",
    "workspace_mount_path": "/workspace",
    "clean_workspace_mount": true,
    "agent_cwd": "/workspace",
    "max_turns": 15,
    "system_prompt_prefix_file": "runtime/system_prompt_prefix.txt",
    "mock_today": "2026-10-20"
  },
  "scripts": {
    "setup": "scripts/setup.sh",
    "start_services": "scripts/start_services.sh",
    "stop_services": "scripts/stop_services.sh"
  },
  "tools": [
    "tools/ivf_predict_outcome.json",
    "tools/ivf_similar_patients.json"
  ],
  "grader": {
    "files": [
      {
        "source": "grader",
        "target": "/tmp/omni_grader",
        "copy_mode": "contents",
        "required": true
      }
    ],
    "kind": "llm_judge",
    "aggregation": "weighted_sum",
    "items": [
      {
        "name": "automated_checks",
        "type": "llm_judge",
        "weight": 1.0
      }
    ],
    "setup": "grader/setup.sh",
    "run": "grader/run.sh",
    "cwd": "/tmp/omni_grader",
    "grader_mount_path": "/tmp/omni_grader",
    "result": {
      "format": "json_stdout",
      "score_field": "overall_score",
      "scores_field": "scores"
    },
    "runtime": "v4_shared"
  },
  "requirements": {
    "env": [],
    "grader_env": [],
    "capabilities": [
      "llm_judge"
    ]
  },
  "timeouts": {
    "setup_seconds": 240,
    "services_seconds": 240,
    "agent_seconds": 600,
    "grader_seconds": 240
  },
  "source": {
    "dataset": "ivf_clinical_tools",
    "subset": "similar_patients",
    "original_id": "ivf-similar-patients-and-prediction-age-amh",
    "original_path": "task.json",
    "converter": "manual",
    "converter_version": "0.1.0"
  },
  "tags": [
    "ivf",
    "clinical-tools",
    "omni-task-format"
  ],
  "metadata": {
    "category": "tool_use",
    "difficulty": "2",
    "services": [
      {
        "name": "ivf_similar",
        "command": "python3 /tmp/omni_services/ivf_services/similar/server.py",
        "port": 9201,
        "health_check": "http://localhost:9201/health",
        "health_check_method": "GET",
        "ready_timeout": 60,
        "env": {
          "PYTHONPATH": "/tmp/omni_services",
          "IVF_TRAIN_CSV": "/tmp/omni_services/data/train_age_amh_gn.csv",
          "IVF_SIMILAR_PORT": "9201",
          "IVF_LOG_DIR": "/tmp/omni_task/logs"
        }
      },
      {
        "name": "ivf_predict",
        "command": "python3 /tmp/omni_services/ivf_services/predict/server.py",
        "port": 9202,
        "health_check": "http://localhost:9202/health",
        "health_check_method": "GET",
        "ready_timeout": 30,
        "env": {
          "PYTHONPATH": "/tmp/omni_services",
          "IVF_MODEL": "/tmp/omni_services/models/lr_35_indicators.json",
          "IVF_PREDICT_PORT": "9202",
          "IVF_LOG_DIR": "/tmp/omni_task/logs"
        }
      }
    ],
    "service_count": 2,
    "tool_count": 2,
    "expected_behaviors": [
      "初诊：结合年龄与周期前检查指出关键异常和可疑数据；用 age、amh 调用 ivf_predict_outcome 和 ivf_similar_patients 各一次。",
      "促排卵与取卵：用 age、amh、gn_days 再调用一次 ivf_predict_outcome。",
      "胚胎：不调用工具；有胚胎信息时定性说明，没有则写未提供。",
      "先分析后结论，最后一行为 结论：妊娠 / 未妊娠 / 不确定 之一。",
      "回答精简，只引用工具返回的数字，不给治疗或用药建议。"
    ],
    "grading_spec": {
      "kind": "deterministic",
      "items": {
        "outcome": "0.60，按类别平衡的结局分（真实妊娠：答对 1.0、答错 0.0；真实未妊娠：答对 0.823、答错 0.177；不确定 0.5），任何固定答案的期望分都是 0.5",
        "tool_use": "0.15，初诊预测（age、amh）、促排预测（加 gn_days）、相似人群检索各一次，参数与病例一致",
        "faithfulness": "0.10，回答中的百分数和例数都能在工具返回或总体妊娠率 39% 中找到",
        "format": "0.05，三个阶段按顺序出现，结论在最后一行",
        "concise": "0.10，回答不超过 300 字满分，600 字为 0",
        "gate": "出现治疗或用药建议，整题 0 分"
      },
      "label_source": "metadata.json（Agent 结束后才复制进评分目录）"
    },
    "judge_rubric": "本任务不使用 LLM 评审；评分见 grader/grader.py。",
    "persona_id": null,
    "prompt_language": "zh",
    "primary_dimensions": [
      "outcome",
      "faithfulness"
    ],
    "scoring_components": [],
    "safety_checks": [],
    "environment_mode": "task_local_scripts",
    "source_task_dir_name": "ivf_clinical_tools",
    "output_task_dir_name": "ivf_clinical_tools"
  }
}
