  ],
  "grader": {
    "files": [
      {
        "source": "grader",
        "target": "/tmp/omni_grader",
        "copy_mode": "contents",
        "required": true
      }
    ],
    "kind": "llm_judge",
    "aggregation": "weighted_sum",
    "items": [
      {
        "name": "automated_checks",
        "type": "llm_judge",
        "weight": 1.0
      }
    ],
    "setup": "grader/setup.sh",
    "run": "grader/run.sh",
    "cwd": "/tmp/omni_grader",
    "grader_mount_path": "/tmp/omni_grader",
    "result": {
      "format": "json_stdout",
      "score_field": "overall_score",
      "scores_field": "scores"
    },
    "runtime": "v4_shared"
  },
  "requirements": {
    "env": [
      "IVF_TRAIN_CSV"
    ],
    "grader_env": [],
