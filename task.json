      },
      {
        "source": "scripts",
        "target": "/tmp/omni_task/scripts",
        "copy_mode": "contents",
        "required": true
      },
      {
        "source": "tools",
        "target": "/tmp/omni_task/tools",
        "copy_mode": "contents",
        "required": true
      },
      {
        "source": "services",
        "target": "/tmp/omni_services",
        "copy_mode": "contents",
        "required": true
      },
      {
        "source": "runtime",
        "target": "/tmp/omni_task/runtime",
        "copy_mode": "contents",
        "required": true
      }
    ]
  },
  "runtime": {
    "task_mount_path": "/tmp/omni_task",
