{
  "name": "ivf_predict_outcome",
  "description": "预测当前患者本次移植的临床妊娠概率及 95% 置信区间。模型为在 35 项指标上训练的逻辑回归，预测时接收女方年龄、AMH、Gn 用药总天数，以及模型中系数较大的女方凝血 PT、TT、白细胞计数、男方精子存活率、精液处理后 IM（至少提供一项；病例未提供的指标不要传，也不要填 0），其余指标及未提供的指标按训练集均值代替。同时返回每个输入对概率的影响（只把该项从训练集均值换成当前取值时，概率升高或降低多少）。模型区分能力有限（交叉验证 AUC 约 0.6），置信区间只反映模型系数的不确定性，不是个体结局的范围。",
  "input_schema": {
    "type": "object",
    "properties": {
      "age": {
        "type": "number",
        "description": "女方年龄（岁）",
        "minimum": 18,
        "maximum": 55
      },
      "amh": {
        "type": "number",
        "description": "女方 AMH（ng/mL）",
        "minimum": 0,
        "maximum": 50
      },
      "gn_days": {
        "type": "number",
        "description": "女方 Gn 用药总天数（天）",
        "minimum": 1,
        "maximum": 30
      },
      "pt": {
        "type": "number",
        "description": "女方凝血常规 PT（秒）",
        "minimum": 5,
        "maximum": 60
      },
      "tt": {
        "type": "number",
        "description": "女方凝血常规 TT（秒）",
        "minimum": 5,
        "maximum": 60
      },
      "wbc": {
        "type": "number",
        "description": "女方白细胞计数（×10^9/L）",
        "minimum": 0.5,
        "maximum": 50
      },
      "sperm_survival": {
        "type": "number",
        "description": "男方精子存活率（%）",
        "minimum": 0,
        "maximum": 100
      },
      "post_wash_im": {
        "type": "number",
        "description": "男方精液处理后 IM（按病例中给出的数值填写）",
        "minimum": 0,
        "maximum": 100
      }
    },
    "additionalProperties": false
  },
  "backend": {
    "type": "http",
    "service": "ivf_tools",
    "method": "POST",
    "url": "http://127.0.0.1:9201/tools/ivf_predict_outcome"
  }
}
