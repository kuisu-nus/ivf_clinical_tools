{
  "name": "contacts_search",
  "description": "按名字搜索联系人",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "搜索关键词（姓名）"
      },
      "department": {
        "type": "string",
        "description": "按部门筛选"
      }
    },
    "required": [
      "query"
    ]
  },
  "backend": {
    "type": "http",
    "service": "contacts",
    "url": "http://127.0.0.1:9103/contacts/search",
    "method": "POST"
  }
}