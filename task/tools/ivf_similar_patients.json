{
  "name": "ivf_similar_patients",
  "description": "按女方年龄和 AMH 在去泄露的 IVF-ET 训练病例中检索相似人群（年龄 ±age_window 岁、AMH 同一档：<1.2 / 1.2–3.5 / >3.5 ng/mL），返回相似患者的年龄、AMH 和临床妊娠结局分布（妊娠率及 95% 置信区间）。符合条件少于 15 例时拒绝返回统计结果，只告知例数。",
  "input_schema": {
    "type": "object",
    "properties": {
      "age": {
        "type": "number",
        "description": "当前患者女方年龄（岁）"
      },
      "amh": {
        "type": "number",
        "description": "当前患者女方 AMH（ng/mL）"
      },
      "age_window": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3,
        "default": 1,
        "description": "年龄上下浮动的岁数，默认 1"
      }
    },
    "required": [
      "age",
      "amh"
    ],
    "additionalProperties": false
  },
  "backend": {
    "type": "http",
    "service": "ivf_clinical",
    "url": "http://127.0.0.1:9201/ivf/similar_patients",
    "method": "POST"
  }
}
